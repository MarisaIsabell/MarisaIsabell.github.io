      <span class="page-hero-label">Publications</span>
      <h1>Publications</h1>
    </div>
  </section>

  <main class="inner-main">
    <section class="inner-section">
      <div class="inner-content">
        <p class="intro-text">
          Listed by year. DOI links point to the publication or preprint record.
          For a complete list including citation metrics, see
          <a href="https://orcid.org/0000-0002-1485-415X" target="_blank" rel="noopener noreferrer">ORCID</a> or
          <a href="https://scholar.google.com/citations?hl=en&user=rikPBz0AAAAJ" target="_blank" rel="noopener noreferrer">Google Scholar</a>.
        </p>
        <div id="publication-list">
          <p>Loading publications…</p>
        </div>
      </div>
    </section>
  </main>

  <footer>
    <p>© 2026 Marisa Isabell Keller</p>
    <p>
      <a href="mailto:marisa.keller@sund.ku.dk">Email</a> ·
      <a href="https://github.com/MarisaIsabell">GitHub</a> ·
      <a href="https://scholar.google.com/citations?hl=en&user=rikPBz0AAAAJ">Google Scholar</a> ·
      <a href="https://orcid.org/0000-0002-1485-415X">ORCID</a>
    </p>
  </footer>

  <script>
  // Parse Zotero CSL-JSON format (author[] with family/given, issued.date-parts)
  function formatAuthors(authors) {
    if (!authors || !authors.length) return "";
    return authors
      .filter(a => a.family) // skip literal consortium entries
      .map(a => {
        const initial = a.given ? a.given[0] + "." : "";
        return `${a.family}, ${initial}`;
      })
      .join(", ");
  }

  function getYear(pub) {
    // CSL-JSON: issued["date-parts"][[year, month, day]]
    if (pub.issued && pub.issued["date-parts"] && pub.issued["date-parts"][0]) {
      return String(pub.issued["date-parts"][0][0]);
    }
    return "n.d.";
  }

  function getJournal(pub) {
    if (pub["container-title"]) return pub["container-title"];
    if (pub.publisher) return pub.publisher;
    if (pub.type === "thesis") return "Doctoral thesis";
    return "Preprint";
  }

  function isPreprint(pub) {
    return pub.publisher === "bioRxiv" || pub.publisher === "medRxiv" || pub.type === "article";
  }

  async function loadPublications() {
    const list = document.getElementById("publication-list");

    try {
      const response = await fetch("publications.json");
      const publications = await response.json();

      const normalized = publications.map(pub => ({
        year: getYear(pub),
        authors: formatAuthors(pub.author),
        title: pub.title || "",
        journal: getJournal(pub),
        doi: pub.DOI || "",
        preprint: isPreprint(pub),
        type: pub.type || "article-journal"
      }));

      // Group by year, newest first
      const grouped = {};
      normalized.forEach(pub => {
        if (!grouped[pub.year]) grouped[pub.year] = [];
        grouped[pub.year].push(pub);
      });

      list.innerHTML = "";

      Object.keys(grouped)
        .sort((a, b) => b.localeCompare(a))
        .forEach(year => {
          const yearGroup = document.createElement("div");
          yearGroup.className = "pub-year-group";

          const yearLabel = document.createElement("div");
          yearLabel.className = "pub-year-label";
          yearLabel.textContent = year;
          yearGroup.appendChild(yearLabel);

          grouped[year].forEach(pub => {
            const entry = document.createElement("div");
            entry.className = "pub-entry";

            const doiLink = pub.doi
              ? `<a href="https://doi.org/${pub.doi}" target="_blank" rel="noopener noreferrer" class="pub-doi">↗ doi:${pub.doi}</a>`
              : "";

            const badge = pub.preprint
              ? `<span class="pub-badge pub-badge--preprint">Preprint</span>`
              : pub.type === "thesis"
              ? `<span class="pub-badge pub-badge--thesis">Thesis</span>`
              : "";

            entry.innerHTML = `
              <div class="pub-meta">
                <span class="pub-authors">${pub.authors}</span>
                <strong class="pub-title">${pub.title}</strong>
                <span class="pub-journal"><em>${pub.journal}</em>${badge}</span>
                ${doiLink}
              </div>
            `;

            yearGroup.appendChild(entry);
          });

          list.appendChild(yearGroup);
        });

    } catch (error) {
      console.error(error);
      list.innerHTML = "<p>Publication list could not be loaded.</p>";
    }
  }

  loadPublications();
  </script>
</body>
</html>
